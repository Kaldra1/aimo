---
/** Таблиця індивідуальних варіантів заняття з src/data/variants/<id>.yaml. */
import 'katex/dist/katex.min.css';
import { inlineTask } from '../lib/variants/inline';
import { url } from '../lib/url';
import { loadVariants, loadVariantTests } from '../lib/variants/load';
import { tasksOf, VARIANTS, variantTaskId, variantTaskPath } from '../lib/variants/variants';

interface Props {
  /** Ім'я файлу без розширення, наприклад practical-01. */
  id: string;
}

const { id } = Astro.props;
const data = loadVariants(id);
/** Кнопка «Виконати» (одна на варіант, веде до ★) — лише там, де є тести для автоперевірки. */
const checkable = loadVariantTests(id) !== null;

const rows = Array.from({ length: VARIANTS }, (_, i) => ({
  n: i + 1,
  tasks: tasksOf(data, i + 1),
}));
const HEADERS = ['★ — обов’язкове', '★★ — на занятті', '★★★ — за бажанням, удома'];
---

<div class="variants">
  <table>
    <thead>
      <tr>
        <th scope="col">Варіант</th>
        {HEADERS.map((h) => (
          <th scope="col">{h}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map(({ n, tasks }) => (
        <tr>
          <th scope="row">
            <span class="variants__number">{n}</span>
            {checkable && (
              <a
                class="button button--secondary variants__button"
                href={url(variantTaskPath(id, n, 1))}
              >
                Виконати
              </a>
            )}
          </th>
          {tasks.map((task, s) => (
            <td>
              <p set:html={inlineTask(task.task)} />
              {(task.alphabet || task.examples.length > 0) && (
                <p class="variants__meta">
                  {task.alphabet && <>Алфавіт: {task.alphabet}. </>}
                  {task.examples.length > 0 && (
                    <>
                      Приклади:{' '}
                      {task.examples.map((example, k) => (
                        <>
                          {k > 0 && '; '}
                          <code>{example}</code>
                        </>
                      ))}
                    </>
                  )}
                </p>
              )}
              {checkable && (
                <p class="variants__solved" data-task-id={variantTaskId(id, n, s + 1)} hidden>
                  ✓ Розв’язано
                </p>
              )}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<script>
  // Позначка «розв’язано» з прогресу в браузері (localStorage, той самий, що в розділі «Задачі»).
  try {
    const raw = window.localStorage.getItem('aimo:progress');
    const solved: Record<string, string> = raw ? (JSON.parse(raw).solved ?? {}) : {};
    document.querySelectorAll<HTMLElement>('[data-task-id]').forEach((mark) => {
      if (solved[mark.dataset.taskId ?? ''] !== undefined) mark.removeAttribute('hidden');
    });
  } catch {
    // Сховище недоступне — просто без позначок.
  }
</script>

<style>
  .variants__button {
    min-height: 2.25rem;
    padding-block: var(--space-1);
    font-size: var(--text-sm);
  }

  .variants__solved {
    margin-top: var(--space-2) !important;
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .variants {
    max-width: 100%;
    overflow-x: auto;
  }

  .variants table {
    display: table;
    width: 100%;
  }

  .variants table td p {
    margin: 0;
  }

  .variants table td p + p {
    margin-top: var(--space-1);
  }

  .variants__meta {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .variants__meta code {
    white-space: nowrap;
  }

  .variants tbody th {
    text-align: center;
    vertical-align: top;
  }

  .variants__number {
    display: block;
  }

  .variants__button {
    margin-top: var(--space-2);
  }

  .variants td {
    vertical-align: top;
    min-width: 12rem;
  }
</style>
