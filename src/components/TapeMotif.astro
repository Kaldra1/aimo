---
/** Декоративна стрічка машини Тюрінга для головної сторінки. */
const cells = ['λ', '1', '0', '1', '1', '0', '1', 'λ', 'λ'];
const head = 4;
---

<div class="tape" aria-hidden="true">
  <div class="tape__track">
    {cells.map((symbol, index) => (
      <span class:list={['tape__cell', { 'tape__cell--head': index === head }]}>
        {index === head && (
          <span class="tape__state">
            q<sub>0</sub>
          </span>
        )}
        {symbol}
        {index === head && (
          <svg class="tape__caret" viewBox="0 0 20 14" width="20" height="14">
            <path d="M10 1L19 13H1z" />
          </svg>
        )}
      </span>
    ))}
  </div>
</div>

<style>
  .tape {
    display: flex;
    justify-content: center;
    padding-block: var(--space-6) var(--space-5);
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }

  .tape__track {
    display: flex;
    flex: none;
  }

  .tape__cell {
    position: relative;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    margin-left: -2px;
    border: 2px solid var(--color-primary);
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    font-weight: 700;
  }

  .tape__cell--head {
    z-index: 1;
    background: var(--color-accent-soft);
    outline: 3px solid var(--color-accent);
    outline-offset: -1px;
    box-shadow: 0 0 0 5px var(--color-on-accent);
  }

  .tape__state {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    color: var(--color-primary);
    font-size: var(--text-base);
  }

  .tape__caret {
    position: absolute;
    top: calc(100% + 0.5rem);
    width: 1.25rem;
    height: 0.875rem;
    fill: var(--color-accent);
    stroke: var(--color-on-accent);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
</style>
