---
import { url } from '../lib/url';
import Icon from './Icon.astro';

interface Props {
  title: string;
  description: string;
  href?: string;
  meta?: string | undefined;
  soon?: boolean;
  tone?: 'mint' | 'blue' | 'amber';
  level?: 2 | 3;
}

const { title, description, href, meta, soon = false, tone = 'mint', level = 2 } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
---

<article
  class:list={['card', 'section-card', `section-card--${tone}`, { 'card--link': Boolean(href) }]}
>
  {Astro.slots.has('icon') && (
    <div class="section-card__icon">
      <slot name="icon" />
    </div>
  )}
  <div class="section-card__copy">
    <Heading class="section-card__title">
      {href ? (
        <a class="card__link section-card__link" href={url(href)}>
          {title}
        </a>
      ) : (
        title
      )}
    </Heading>
    <p class="section-card__text">{description}</p>
  </div>
  {(meta || soon) && (
    <p class="section-card__meta">
      {meta}
      {soon && <span class="badge badge--soon">У розробці</span>}
    </p>
  )}
  {href && <Icon name="arrowRight" class="section-card__arrow" />}
  <slot />
</article>

<style>
  .section-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-content: start;
    column-gap: var(--space-4);
    row-gap: var(--space-5);
    height: 100%;
    min-height: 12rem;
    background: var(--color-mint-card);
    box-shadow: none;
  }
  .section-card--blue {
    background: var(--color-blue-card);
  }
  .section-card--amber {
    background: var(--color-amber-card);
  }
  .section-card__icon {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 22px;
    background: var(--color-primary-soft);
    color: var(--color-primary);
  }
  .section-card--blue .section-card__icon {
    background: var(--color-blue-icon);
    color: var(--color-blue-text);
  }
  .section-card--amber .section-card__icon {
    background: var(--color-accent-soft);
    color: var(--color-accent-text);
  }
  .section-card__icon :global(svg) {
    width: 1.875rem;
    height: 1.875rem;
  }
  .section-card__copy {
    align-self: center;
    min-width: 0;
  }
  .section-card__title {
    font-size: var(--text-xl);
  }
  .section-card__link {
    color: var(--color-text);
    text-decoration: none;
  }
  .section-card__link:hover {
    color: var(--color-primary);
  }
  .section-card__text {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
  .section-card__meta {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: auto;
    padding-right: var(--space-6);
    min-height: 2.75rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
  .section-card :global(.section-card__arrow) {
    position: absolute;
    bottom: 2.25rem;
    right: var(--space-5);
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-primary);
    pointer-events: none;
  }
  @media (max-width: 55.99rem) {
    .section-card {
      min-height: auto;
      gap: var(--space-2) var(--space-4);
    }
    .section-card__icon {
      grid-row: 1 / 3;
      align-self: center;
    }
    .section-card__meta {
      grid-column: 2;
      min-height: auto;
    }
    .section-card :global(.section-card__arrow) {
      bottom: var(--space-5);
    }
  }
</style>
