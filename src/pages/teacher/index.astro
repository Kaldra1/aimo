---
import '../../styles/emulator.css';
import '../../styles/cloud.css';
import TeacherDashboard from '../../components/cloud/TeacherDashboard';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadCloudMeta } from '../../lib/cloud/meta';
import { DEFAULT_RULES, GRADE_LABELS, type Grade } from '../../lib/grading/grade';
import { JOURNAL_TOPICS } from '../../lib/grading/journal';

const meta = await loadCloudMeta();
const labelOf = (id: string) => meta.sessions.find((s) => s.id === id)?.label ?? id;
const topics = JOURNAL_TOPICS.map((t) => `${t.label} — ${t.sessions.map(labelOf).join(', ')}`);
const [early, middle] = DEFAULT_RULES.windows;
const label = (grade: Grade) => `«${GRADE_LABELS[grade]}»`;
const volume =
  `виконано ★ — ${label(DEFAULT_RULES.byStars[1])}, ★ і ★★ — ${label(DEFAULT_RULES.byStars[2])}` +
  (DEFAULT_RULES.byStars[3] > DEFAULT_RULES.byStars[2]
    ? `, до ★★★ — ${label(DEFAULT_RULES.byStars[3])}`
    : '; ★★★ — для охочих, оцінку не підвищує');
const deadline = `до ${early!.days} днів — без обмежень, до ${middle!.days} днів — не вище ${label(middle!.cap)}, пізніше — не вище ${label(DEFAULT_RULES.lateCap)}`;
---

<BaseLayout
  title="Дашборд викладача"
  description="Дашборд викладача: прогрес студентів і оцінювання індивідуальних завдань."
  breadcrumbs={[{ label: 'Дашборд викладача' }]}
  noindex
>
  <div class="container page">
    <header class="page-header">
      <h1>Дашборд викладача</h1>
      <p class="lead">
        Групи, студенти, розв’язані індивідуальні завдання й оцінки. Доступ — лише для викладача
        після входу.
      </p>
    </header>

    <TeacherDashboard client:only="preact" sessions={meta.sessions} tests={meta.tests} />

    <section class="teacher-grading" aria-labelledby="grading-title">
      <h2 id="grading-title">Оцінювання</h2>
      <p>
        На кожному рівні дашборд показує <strong>рекомендовану</strong> оцінку, а{' '}
        <strong>остаточну</strong> завжди ставить викладач.
      </p>

      <h3>Заняття (лабораторна чи практична)</h3>
      <p>Рекомендована — менша з двох:</p>
      <ul>
        <li>
          <strong>за обсягом:</strong> {volume}. Без обов’язкового ★ оцінки немає;
        </li>
        <li>
          <strong>за терміном</strong> від дати заняття: {deadline}.
        </li>
      </ul>
      <p>
        Кожне завдання враховується зі своєю датою, тож пізнє доробляння ★★★ не знижує вже
        заробленої оцінки. Поки дати занять не задано, термін не враховується.
      </p>

      <h3>Тематична</h3>
      <p>
        Середнє арифметичне оцінок за заняття теми, округлене за звичайним правилом (3,5 → 4).
        Неоцінені заняття пропускаються, як у таблиці, а підказка позначається «…». Теми журналу:
        {topics.join('; ')}.
      </p>

      <h3>Семестрова</h3>
      <p>
        Середнє тематичних оцінок. Наприкінці семестру — залік, на якому студент може підвищити
        оцінку, тож остаточну семестрову викладач ставить вручну.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .teacher-grading {
    max-width: var(--width-prose);
    margin-top: var(--space-7);
  }

  .teacher-grading h2 {
    margin-bottom: var(--space-3);
  }

  .teacher-grading h3 {
    margin: var(--space-5) 0 var(--space-2);
    font-size: var(--text-lg);
  }

  .teacher-grading ul {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-2) 0;
    padding-left: 1.5em;
  }
</style>
