---
import ComingSoon from '../../components/ComingSoon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { DEFAULT_RULES, GRADE_LABELS } from '../../lib/grading/grade';

const [early, middle] = DEFAULT_RULES.windows;
---

<BaseLayout
  title="Дашборд викладача"
  description="Дашборд викладача: прогрес студентів і оцінювання індивідуальних завдань."
  breadcrumbs={[{ label: 'Дашборд викладача' }]}
  noindex
>
  <div class="container page">
    <header class="page-header">
      <h1>Дашборд викладача</h1>
      <p class="lead">
        Групи, студенти, розв’язані індивідуальні завдання й оцінки. Доступ — лише для викладача
        після входу.
      </p>
    </header>

    <ComingSoon message="Дашборд готується: потрібен вхід студентів і викладача (Supabase).">
      <p>Тут буде таблиця «студенти × заняття × ★/★★/★★★» з датами розв’язання й самими схемами.</p>
    </ComingSoon>

    <section class="teacher-grading" aria-labelledby="grading-title">
      <h2 id="grading-title">Оцінювання</h2>
      <p>
        Оцінку за заняття ставить викладач. Дашборд підкаже <strong>рекомендовану оцінку</strong> —
        меншу з двох:
      </p>
      <ul>
        <li>
          <strong>за обсягом:</strong> виконано ★ — «{GRADE_LABELS[DEFAULT_RULES.byStars[1]]}», до
          ★★ — «{GRADE_LABELS[DEFAULT_RULES.byStars[2]]}», до ★★★ — «
          {GRADE_LABELS[DEFAULT_RULES.byStars[3]]}». Без обов’язкового ★ оцінки немає;
        </li>
        <li>
          <strong>за терміном</strong> від дати заняття: до {early!.days} днів — без обмежень, до{' '}
          {middle!.days} днів — не вище «{GRADE_LABELS[middle!.cap]}», пізніше — не вище «
          {GRADE_LABELS[DEFAULT_RULES.lateCap]}».
        </li>
      </ul>
      <p>
        Кожне завдання враховується зі своєю датою, тож пізнє доробляння ★★★ не знижує вже
        заробленої оцінки. Поки дати занять не задано, термін не враховується.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .teacher-grading {
    max-width: var(--width-prose);
    margin-top: var(--space-7);
  }

  .teacher-grading h2 {
    margin-bottom: var(--space-3);
  }

  .teacher-grading ul {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-3) 0;
    padding-left: 1.5em;
  }
</style>
