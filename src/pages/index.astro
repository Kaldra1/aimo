---
import Icon from '../components/Icon.astro';
import SectionCard from '../components/SectionCard.astro';
import TapeMotif from '../components/TapeMotif.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { course, loadContent } from '../lib/content/collections';
import { MACHINE_META } from '../lib/content/course';
import { plural } from '../lib/plural';
import { url } from '../lib/url';

const { lectures, sessions } = await loadContent();
const labs = sessions.filter((s) => s.data.kind === 'lab');
const practicals = sessions.filter((s) => s.data.kind === 'practical');
const readyMachines = Object.values(MACHINE_META).filter((machine) => machine.ready);
const route = [
  { title: 'Основи', description: 'Як мислити алгоритмічно', icon: 'book', topic: 1 },
  { title: 'Машини', description: 'Від команди до результату', icon: 'tape', topic: 2 },
  { title: 'Алгоритми', description: 'Структури й сортування', icon: 'clipboard', topic: 3 },
  { title: 'Чисельні методи', description: 'Обчислення на практиці', icon: 'check', topic: 4 },
] as const;
---

<BaseLayout>
  <div class="container home">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__copy">
        <p class="hero__eyebrow">Курс комп’ютерної інженерії</p>
        <h1 id="hero-title" class="hero__title">
          <span>Алгоритми</span> і<br />
          методи обчислень
        </h1>
        <p class="hero__lead">Читай. Досліджуй. Практикуйся.</p>
        <div class="hero__actions">
          <a class="button hero__primary" href={url('/about/')}>
            Переглянути програму <Icon name="arrowRight" />
          </a>
          <a class="button hero__secondary" href={url('/lectures/')}>
            До лекцій
          </a>
        </div>
        <p class="hero__note">Без реєстрації · У твоєму темпі</p>
      </div>
      <div class="hero__visual">
        <TapeMotif />
        <p class="hero__caption">Великі ідеї починаються з простих кроків</p>
      </div>
    </section>

    <section class="section explore" aria-labelledby="sections-title">
      <div class="section-heading">
        <h2 id="sections-title">Обери наступний крок</h2>
        <p>Від теорії — до практики</p>
      </div>
      <div class="cards">
        <SectionCard
          title="Лекції"
          href="/lectures/"
          description="Теорія у зрозумілих кроках"
          meta={`${plural(lectures.length, ['лекція', 'лекції', 'лекцій'])} · ${plural(course.modules.length, ['модуль', 'модулі', 'модулів'])}`}
          tone="mint"
          level={3}
        >
          <Icon name="book" slot="icon" />
        </SectionCard>
        <SectionCard title="Практика" description="Спробуй власноруч" tone="blue" level={3}>
          <Icon name="clipboard" slot="icon" />
          <div class="card-links">
            <a href={url('/labs/')} aria-label={`Лабораторні роботи (${labs.length})`}>
              Лабораторні <Icon name="arrowRight" />
            </a>
            <a href={url('/practicals/')} aria-label={`Практичні заняття (${practicals.length})`}>
              Практичні <Icon name="arrowRight" />
            </a>
          </div>
        </SectionCard>
        <SectionCard
          title="Емулятори"
          href="/emulators/"
          description="Побач, як працює алгоритм"
          meta={
            readyMachines.length
              ? `${plural(readyMachines.length, ['машина', 'машини', 'машин'])} у браузері`
              : undefined
          }
          soon={readyMachines.length === 0}
          tone="amber"
          level={3}
        >
          <Icon name="tape" slot="icon" />
        </SectionCard>
      </div>
    </section>

    <section class="section journey" aria-labelledby="route-title">
      <div class="section-heading">
        <h2 id="route-title">Маршрут курсу</h2>
        <a href={url('/about/')}>
          Уся програма <Icon name="arrowRight" />
        </a>
      </div>
      <ol class="route">
        {route.map((step, index) => (
          <li>
            <a class="route__step" href={`${url('/lectures/')}#topic-${step.topic}`}>
              <span class="route__icon">
                <Icon name={step.icon} />
              </span>
              <span class="route__copy">
                <span class="route__number">0{index + 1}</span>
                <span class="route__title">{step.title}</span>
                <span class="route__description">{step.description}</span>
              </span>
              <Icon name="arrowRight" class="route__arrow" />
            </a>
          </li>
        ))}
      </ol>
    </section>
    <aside class="home-note" aria-label="Про навчання">
      <p>
        <Icon name="check" /> Оцінки та здача робіт — у Moodle
      </p>
      <a href={url('/tasks/')}>
        До задач <Icon name="arrowRight" />
      </a>
    </aside>
  </div>
</BaseLayout>

<style>
  .home {
    padding-block: var(--space-4) var(--space-6);
  }
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: var(--space-6);
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    border: 1px solid var(--color-hero-bg);
    border-radius: 24px;
    background: var(--color-hero-bg);
    color: var(--color-hero-text);
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    background: radial-gradient(ellipse at 85% 15%, rgb(53 131 111 / 22%), transparent 65%);
    pointer-events: none;
  }
  .hero__copy,
  .hero__visual {
    min-width: 0;
  }
  .hero__eyebrow {
    display: inline-block;
    margin-bottom: var(--space-5);
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--color-hero-border);
    border-radius: var(--radius-pill);
    color: var(--color-hero-muted);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .hero__title {
    font-size: clamp(1.875rem, 4.05vw, 3.5rem);
    line-height: 1.13;
    letter-spacing: -0.045em;
    text-wrap: initial;
  }
  .hero__title span {
    color: var(--color-hero-accent);
  }
  .hero__lead {
    margin-top: var(--space-5);
    font-size: clamp(1.125rem, 2vw, 1.5rem);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .hero__actions .button {
    min-height: 3.125rem;
    justify-content: center;
    padding-inline: 1.25rem;
  }
  .hero__primary {
    background: var(--color-hero-accent);
    color: var(--color-on-accent);
  }
  .hero__primary:hover {
    background: #f4bd68;
    color: var(--color-on-accent);
  }
  .hero__secondary {
    border-color: var(--color-hero-border);
    color: var(--color-hero-text);
  }
  .hero__secondary:hover {
    background: rgb(255 255 255 / 8%);
    color: var(--color-hero-text);
  }
  .hero :global(:focus-visible) {
    outline-color: var(--color-hero-accent);
  }
  .hero__note {
    margin-top: var(--space-3);
    color: var(--color-hero-muted);
    font-size: var(--text-sm);
  }
  .hero__visual {
    align-self: center;
  }
  .hero__caption {
    margin-top: var(--space-4);
    color: var(--color-hero-muted);
    font-size: 0.75rem;
    text-align: center;
    letter-spacing: 0.04em;
  }
  .explore {
    margin-top: var(--space-7);
  }
  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }
  .section-heading p {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
  .section-heading a,
  .home-note a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .section-heading :global(svg),
  .home-note :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
    flex: none;
  }
  .cards {
    display: grid;
    gap: var(--space-4);
  }
  .card-links {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    align-self: end;
  }
  .card-links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    color: var(--color-blue-text);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }
  .card-links a:hover {
    text-decoration: underline;
  }
  .card-links :global(svg) {
    width: 1rem;
    height: 1rem;
  }
  .journey h2 {
    font-size: var(--text-xl);
  }
  .route {
    display: grid;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
  }
  .route__step {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    height: 100%;
    min-height: 6rem;
    padding: var(--space-3);
    border-radius: var(--radius-card);
    color: var(--color-text);
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .route__step:hover {
    background: var(--color-surface-strong);
    color: var(--color-text);
  }
  .route__icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    color: var(--color-primary);
    background: var(--color-primary-soft);
  }
  .route li:nth-child(even) .route__icon {
    color: var(--color-blue-text);
    background: var(--color-blue-icon);
  }
  .route__copy {
    display: grid;
    gap: 0.125rem;
  }
  .route__number {
    color: var(--color-text-muted);
    font: 0.75rem var(--font-mono);
  }
  .route__title {
    font-family: var(--font-heading);
    font-weight: 700;
  }
  .route__description {
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }
  .route__step :global(.route__arrow) {
    width: 1rem;
    height: 1rem;
    flex: none;
    margin-left: auto;
    color: var(--color-text-muted);
  }
  .home-note {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
  .home-note p {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  @media (min-width: 40rem) {
    .route {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 56rem) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: 1.18fr 1fr;
      gap: var(--space-7);
      min-height: 25rem;
      align-items: center;
    }
    .route {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (max-width: 39.99rem) {
    .hero {
      border-radius: 20px;
    }
    .hero__eyebrow {
      font-size: 0.625rem;
      letter-spacing: 0.075em;
    }
    .hero__actions {
      gap: var(--space-2);
    }
    .hero__actions .button {
      width: 100%;
    }
    .hero__actions .hero__secondary {
      display: none;
    }
    .hero__caption,
    .section-heading > p {
      display: none;
    }
    .hero__note {
      text-align: center;
    }
    .section-heading h2 {
      font-size: 1.5rem;
    }
    .journey .section-heading h2 {
      font-size: var(--text-xl);
    }
    .route__step {
      padding-block: var(--space-2);
      min-height: 5rem;
    }
  }
</style>
