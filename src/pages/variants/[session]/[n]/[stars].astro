---
import 'katex/dist/katex.min.css';
import { inlineTask } from '../../../../lib/variants/inline';
import '../../../../styles/emulator.css';
import '../../../../styles/markov.css';
import '../../../../styles/prose.css';
import '../../../../styles/tasks.css';
import MarkovHelp from '../../../../components/markov/MarkovHelp.astro';
import PostHelp from '../../../../components/post/PostHelp.astro';
import TuringHelp from '../../../../components/turing/TuringHelp.astro';
import PrevNext from '../../../../components/PrevNext.astro';
import TaskWorkbench, { type TaskView } from '../../../../components/tasks/TaskWorkbench';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { loadContent } from '../../../../lib/content/collections';
import { sessionPath, sessionShortLabel } from '../../../../lib/content/course';
import { DEFAULT_MAX_STEPS } from '../../../../lib/tasks/check';
import { LONG_MAX_STEPS } from '../../../../lib/cloud/solutions';
import { url } from '../../../../lib/url';
import { checkableSessions, loadVariants, loadVariantTests } from '../../../../lib/variants/load';
import {
  splitExample,
  tasksOf,
  testsKey,
  VARIANTS,
  variantTaskId,
  variantTaskPath,
} from '../../../../lib/variants/variants';

export async function getStaticPaths() {
  const { sessions } = await loadContent();
  return checkableSessions().flatMap((id) => {
    const session = sessions.find((s) => s.id === id);
    if (!session) throw new Error(`Варіанти «${id}»: заняття з таким файлом не знайдено`);
    const data = loadVariants(id);
    const machine = data.machine;
    if (machine !== 'markov' && machine !== 'post' && machine !== 'turing') {
      throw new Error(`Варіанти «${id}»: автоперевірки для машини «${machine}» немає`);
    }
    const tests = loadVariantTests(id)!;
    return Array.from({ length: VARIANTS }, (_, i) => i + 1).flatMap((n) =>
      tasksOf(data, n).map((task, s) => {
        const stars = s + 1;
        const lines = tests[testsKey(n, stars)];
        if (!lines) throw new Error(`Варіанти «${id}»: немає тестів для ${testsKey(n, stars)}`);
        return {
          params: { session: id, n: String(n), stars: String(stars) },
          props: {
            id,
            title: session.data.title,
            kind: session.data.kind,
            number: session.data.number,
            n,
            stars,
            task,
            lines,
            machine,
          },
        };
      }),
    );
  });
}

const { id, title, kind, number, n, stars, task, lines, machine } = Astro.props;
const sessionHref = sessionPath(kind, number);
const label = sessionShortLabel(kind, number);
const starText = '★'.repeat(stars);

const view: TaskView = {
  id: variantTaskId(id, n, stars),
  machine,
  // «0–9» в умові — це всі цифри від 0 до 9.
  alphabet: (task.alphabet ?? '')
    .replace(/(\d)–(\d)/g, (_: string, a: string, b: string) =>
      Array.from({ length: Number(b) - Number(a) + 1 }, (_, i) => String(Number(a) + i)).join(''),
    )
    .replace(/[\s,]+/g, ''),
  starter: '',
  tests: lines.map((line: string) => {
    const { input, output } = splitExample(line);
    return { input, expected: output, checkHead: false };
  }),
  hints: [],
  // Програми машин Поста й Тюрінга бувають довгими (множення, степінь), тож ліміт більший.
  maxSteps: machine === 'markov' ? DEFAULT_MAX_STEPS : LONG_MAX_STEPS,
};

const neighbour = (s: number) =>
  s >= 1 && s <= 3
    ? { href: variantTaskPath(id, n, s), title: `Варіант ${n} · ${'★'.repeat(s)}` }
    : undefined;
---

<BaseLayout
  title={`${label}, варіант ${n} · ${starText}`}
  description={`Індивідуальне завдання ${label} «${title}», варіант ${n}, ${starText}. Автоматична перевірка в емуляторі.`}
  section={kind === 'lab' ? 'labs' : 'practicals'}
  breadcrumbs={[
    kind === 'lab'
      ? { label: 'Лабораторні', href: '/labs/' }
      : { label: 'Практичні', href: '/practicals/' },
    { label: `${label}. ${title}`, href: sessionHref },
    { label: `Варіант ${n} · ${starText}` },
  ]}
>
  <article class="container page page--emulator task-page">
    <header class="page-header page-header--compact">
      <p class="eyebrow">{label} · індивідуальне завдання</p>
      <h1>
        Варіант {n} · {starText}
      </h1>
      <nav class="variant-levels" aria-label="Рівні завдання">
        {[1, 2, 3].map((s) => (
          <a
            class={`button ${s === stars ? 'button--primary' : 'button--secondary'}`}
            href={url(variantTaskPath(id, n, s))}
            aria-current={s === stars ? 'page' : undefined}
          >
            {'★'.repeat(s)}
          </a>
        ))}
      </nav>
      <ul class="task-meta">
        <li>
          {stars === 1
            ? 'Базова складність'
            : stars === 2
              ? 'Середня складність'
              : 'Підвищена складність'}
        </li>
        {task.alphabet && (
          <li>
            Алфавіт: <code>{task.alphabet}</code> (можна додати{' '}
            {machine === 'markov' ? 'маркери' : 'допоміжні символи'})
          </li>
        )}
      </ul>
    </header>

    <div class="prose task-statement">
      <p set:html={inlineTask(task.task)} />
      {task.examples.length > 0 && (
        <p>
          <strong>Приклади.</strong>{' '}
          {task.examples.map((example: string, k: number) => (
            <>
              {k > 0 && '; '}
              <code>{example}</code>
            </>
          ))}
        </p>
      )}
      <p>
        <a href={url(`${sessionHref}#варіанти`)}>← До таблиці варіантів</a>
      </p>
    </div>

    <TaskWorkbench client:load task={view} />

    {machine === 'post' ? <PostHelp /> : machine === 'turing' ? <TuringHelp /> : <MarkovHelp />}

    <PrevNext
      prev={neighbour(stars - 1)}
      next={neighbour(stars + 1)}
      prevLabel="Попереднє завдання"
      nextLabel="Наступне завдання"
    />
  </article>
</BaseLayout>

<style>
  .variant-levels {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block: var(--space-2);
  }
</style>
