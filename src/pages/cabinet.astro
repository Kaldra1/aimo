---
import '../styles/emulator.css';
import '../styles/cloud.css';
import Cabinet from '../components/cloud/Cabinet';
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadCloudMeta } from '../lib/cloud/meta';

const { sessions } = await loadCloudMeta();
---

<BaseLayout
  title="Кабінет студента"
  description="Особистий кабінет студента: розв’язані індивідуальні завдання й дати розв’язання."
  section="cabinet"
  breadcrumbs={[{ label: 'Кабінет' }]}
  noindex
>
  <div class="container page">
    <header class="page-header">
      <h1>Кабінет студента</h1>
      <p class="lead">
        Які індивідуальні завдання ви розв’язали й коли. Після входу кожен успішно перевірений
        розв’язок свого варіанта зберігається тут, і його бачить викладач.
      </p>
    </header>
    <Cabinet client:only="preact" sessions={sessions} />
  </div>
</BaseLayout>
